# GridMind example environment
GRIDMIND_MASTER_IP=192.168.0.10
GRIDMIND_MASTER_PORT=5577
GRIDMIND_WORKER_COMMAND_PORT=5556
GRIDMIND_SHARED_SECRET=change-this-secret
GRIDMIND_AUTO_ONBOARD=true
GRIDMIND_REQUIRE_USER_CONSENT=true
GRIDMIND_CONSENT_WEB_PORT=8765
GRIDMIND_CONSENT_TIMEOUT_SECONDS=180
GRIDMIND_CONSENT_EVERY_SESSION=true
GRIDMIND_HTTP_REROUTE_ENABLED=true
GRIDMIND_JOIN_PAGE_AUTO_LAUNCH=true
GRIDMIND_JOIN_PAGE_RELAUNCH_SECONDS=20
# Legacy compatibility (optional)
# MASTER_NODE_IP=192.168.0.10
# MASTER_LISTEN_PORT=5577
# WORKER_LISTEN_PORT=5556
GRIDMIND_HEARTBEAT_TIMEOUT=30
GRIDMIND_HEARTBEAT_INTERVAL=10
GRIDMIND_ANNOUNCE_MAX_RETRIES=4
GRIDMIND_TASK_TIMEOUT=45
GRIDMIND_CHUNK_MIN_LINES=10
GRIDMIND_CHUNK_MAX_LINES=80
GRIDMIND_MAX_ACTIVE_TASKS_PER_WORKER=1
GRIDMIND_BENCHMARK_ON_TOPOLOGY_CHANGE=true
GRIDMIND_BENCHMARK_REDISPATCH_COOLDOWN=20
GRIDMIND_OUTBOX_RETRY_BASE=3
GRIDMIND_OUTBOX_RETRY_MAX=60
GRIDMIND_OUTBOX_MAX_RETRY=8
GRIDMIND_FL_ENABLED=true
GRIDMIND_FL_MIN_CLIENTS=1
GRIDMIND_FL_ROUND_TIMEOUT=120
