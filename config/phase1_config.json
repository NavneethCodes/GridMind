{
  "master": {
    "master_ip": "192.168.0.10",
    "master_listen_port": 5577,
    "heartbeat_timeout_seconds": 30,
    "task_timeout_seconds": 45
  },
  "scheduler": {
    "chunk_min_lines": 10,
    "chunk_max_lines": 80,
    "max_task_attempts": 3
  },
  "federated_learning": {
    "enabled": true,
    "min_clients": 1,
    "round_timeout_seconds": 120,
    "notes": "Phase-1 uses mock update aggregation metadata only"
  },
  "security": {
    "checksum_signing": "sha256(shared_secret + canonical_json)",
    "shared_secret_env_var": "GRIDMIND_SHARED_SECRET"
  }
}
